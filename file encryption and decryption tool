from flask import Flask, request, render_template_string
from cryptography.fernet import Fernet
import os

app = Flask(__name__)

# -----------------------------
# Create Encryption Key
# -----------------------------
if not os.path.exists("secret.key"):
    with open("secret.key", "wb") as key_file:
        key_file.write(Fernet.generate_key())

def load_key():
    with open("secret.key", "rb") as key_file:
        return key_file.read()

# Create upload folder
UPLOAD_FOLDER = "uploads"
os.makedirs(UPLOAD_FOLDER, exist_ok=True)

HTML = """
<!DOCTYPE html>
<html>
<head>
<title>Cyber File Encryption Tool</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI',sans-serif;
}

body{
    background:linear-gradient(135deg,#000000,#0f172a,#020617);
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
}

.container{
    width:650px;
    background:rgba(17,17,17,0.95);
    padding:35px;
    border-radius:20px;
    border:2px solid #00ff88;
    box-shadow:0 0 30px #00ff88;
    animation:fadeIn 1s ease;
}

h1{
    text-align:center;
    color:#00ff88;
    margin-bottom:25px;
    text-shadow:0 0 15px #00ff88;
    font-size:32px;
}

input[type=file]{
    width:100%;
    padding:14px;
    background:#000;
    color:#00ff88;
    border:2px solid #00ff88;
    border-radius:10px;
    margin-bottom:15px;
}

button{
    padding:12px 25px;
    border:none;
    border-radius:10px;
    cursor:pointer;
    font-size:16px;
    font-weight:bold;
    transition:0.3s;
    margin-right:10px;
}

.encrypt{
    background:#00ff88;
    color:#000;
}

.encrypt:hover{
    transform:translateY(-3px);
    box-shadow:0 0 15px #00ff88;
}

.decrypt{
    background:#ff6600;
    color:white;
}

.decrypt:hover{
    transform:translateY(-3px);
    box-shadow:0 0 15px #ff6600;
}

.msg{
    margin-top:20px;
    padding:15px;
    border-radius:10px;
    text-align:center;
    font-weight:bold;
}

.success{
    background:#d1fae5;
    color:#065f46;
}

.error{
    background:#fee2e2;
    color:#991b1b;
}

@keyframes fadeIn{
    from{
        opacity:0;
        transform:translateY(20px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}
</style>
</head>

<body>

<div class="container">

<h1>🔐 Cyber File Encryption Tool</h1>

<form method="POST" enctype="multipart/form-data">

<input type="file" name="file" required>

<br>

<button class="encrypt" type="submit" name="action" value="encrypt">
Encrypt File
</button>

<button class="decrypt" type="submit" name="action" value="decrypt">
Decrypt File
</button>

</form>

{% if message %}
<div class="msg {{msg_type}}">
{{message}}
</div>
{% endif %}

</div>

</body>
</html>
"""

@app.route("/", methods=["GET", "POST"])
def home():

    message = ""
    msg_type = ""

    if request.method == "POST":

        uploaded_file = request.files.get("file")

        if not uploaded_file or uploaded_file.filename == "":
            message = "Please select a file."
            msg_type = "error"

        else:

            try:

                data = uploaded_file.read()
                fernet = Fernet(load_key())

                action = request.form.get("action")

                if action == "encrypt":

                    encrypted_data = fernet.encrypt(data)

                    filename = uploaded_file.filename + ".enc"
                    filepath = os.path.join(UPLOAD_FOLDER, filename)

                    with open(filepath, "wb") as f:
                        f.write(encrypted_data)

                    message = f"✅ File Encrypted Successfully! Saved as: {filename}"
                    msg_type = "success"

                elif action == "decrypt":

                    decrypted_data = fernet.decrypt(data)

                    filename = uploaded_file.filename.replace(".enc", "_decrypted")
                    filepath = os.path.join(UPLOAD_FOLDER, filename)

                    with open(filepath, "wb") as f:
                        f.write(decrypted_data)

                    message = f"✅ File Decrypted Successfully! Saved as: {filename}"
                    msg_type = "success"

            except Exception as e:

                message = f"❌ Error: {str(e)}"
                msg_type = "error"

    return render_template_string(
        HTML,
        message=message,
        msg_type=msg_type
    )

if __name__ == "__main__":
    app.run(debug=True)
